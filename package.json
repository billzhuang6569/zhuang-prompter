{
  "name": "zhuang-prompter",
  "version": "0.1.3",
  "description": "Markdown-first local/LAN teleprompter for recorded production.",
  "private": false,
  "license": "MIT",
  "author": "billzhuang6569",
  "repository": {
    "type": "git",
    "url": "https://github.com/billzhuang6569/zhuang-prompter.git"
  },
  "homepage": "https://github.com/billzhuang6569/zhuang-prompter#readme",
  "main": "electron/main.cjs",
  "browserslist": {
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 111",
      "safari >= 15",
      "ios_saf >= 15"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 edge version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:https": "pnpm cert:local && HTTPS=1 SSL_KEY_FILE=.cert/local-key.pem SSL_CERT_FILE=.cert/local-cert.pem pnpm dev",
    "cert:local": "node scripts/setup-local-https.mjs",
    "cert:trust": "node scripts/setup-local-https.mjs --install-ca",
    "build": "next build --webpack",
    "start": "NODE_ENV=production tsx server.ts",
    "desktop:prepare": "pnpm build && node scripts/build-desktop-server.mjs",
    "desktop:dev": "pnpm desktop:prepare && electron .",
    "dist:dir": "pnpm desktop:prepare && electron-builder --dir",
    "dist:mac": "pnpm desktop:prepare && electron-builder --mac",
    "dist:win": "pnpm desktop:prepare && electron-builder --win",
    "lint": "eslint",
    "typecheck": "pnpm build && tsc --noEmit",
    "test:contracts": "tsx --test src/modules/script-engine/editing.test.ts src/modules/script-engine/parse.test.ts src/modules/script-engine/render-bundle-view.test.tsx src/modules/playback-engine/reading-position.test.ts",
    "smoke:network": "node scripts/network-info-smoke.mjs",
    "smoke:m0": "node scripts/m0-smoke.mjs",
    "smoke:m2": "node scripts/m2-smoke.mjs",
    "smoke:m3": "node scripts/m3-smoke.mjs",
    "smoke:m4": "node scripts/m4-smoke.mjs",
    "smoke:m5:reconnect": "node scripts/m5-reconnect-smoke.mjs",
    "smoke:m5:session": "node scripts/m5-session-smoke.mjs",
    "smoke:m5:session:10min": "M5_SESSION_MS=600000 node scripts/m5-session-smoke.mjs",
    "smoke:safari15": "node scripts/safari15-compat-smoke.mjs",
    "acceptance:local": "node scripts/acceptance-report.mjs",
    "install:mac": "node scripts/install-mac.mjs",
    "smoke:reading": "node scripts/reading-browser-smoke.mjs"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.0.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.zhuangsir.prompter",
    "productName": "庄Sir的提词器",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".desktop/server/**/*",
      ".next/**/*",
      "public/**/*",
      "next.config.ts",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "billzhuang6569",
        "repo": "zhuang-prompter"
      }
    ]
  }
}
